# Replace every REPLACE_* value before importing into Render.
# Keep the existing values from your working LTI deployment.
# Same Atlas cluster, SEPARATE database. Preserve your existing connection options.
MONGODB_URL=mongodb+srv://REPLACE_WITH_USERNAME:REPLACE_WITH_URL_ENCODED_PASSWORD@REPLACE_WITH_CLUSTER_HOST/brightspace_activity_date_manager?retryWrites=true&w=majority
LTI_KEY=
PORT=3000
BS_URL=https://REPLACE_WITH_YOUR_BRIGHTSPACE_DOMAIN
BS_NAME=Brightspace
BS_CLIENT_ID=REPLACE_WITH_EXISTING_LTI_CLIENT_ID
BS_AUTH_ENDPOINT=REPLACE_WITH_EXISTING_LTI_AUTH_ENDPOINT
BS_TOKEN_ENDPOINT=https://auth.brightspace.com/core/connect/token
BS_KEYSET_URL=REPLACE_WITH_EXISTING_BRIGHTSPACE_PLATFORM_KEYSET_URL

# Your ALREADY REGISTERED server-to-server OAuth application.
