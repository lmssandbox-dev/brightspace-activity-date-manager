# Replace every REPLACE_* value before importing into Render.
# Keep the existing values from your working LTI deployment.
# Same Atlas cluster, SEPARATE database. Preserve your existing connection options.
MONGODB_URL=mongodb+srv://REPLACE_WITH_USERNAME:REPLACE_WITH_URL_ENCODED_PASSWORD@REPLACE_WITH_CLUSTER_HOST/brightspace_activity_date_manager?retryWrites=true&w=majority
LTI_KEY=REPLACE_WITH_EXISTING_LTI_KEY
PORT=3000
BS_URL=https://REPLACE_WITH_YOUR_BRIGHTSPACE_DOMAIN
BS_NAME=Brightspace
BS_CLIENT_ID=REPLACE_WITH_EXISTING_LTI_CLIENT_ID
BS_AUTH_ENDPOINT=REPLACE_WITH_EXISTING_LTI_AUTH_ENDPOINT
BS_TOKEN_ENDPOINT=https://auth.brightspace.com/core/connect/token
BS_KEYSET_URL=REPLACE_WITH_EXISTING_BRIGHTSPACE_PLATFORM_KEYSET_URL

# Your ALREADY REGISTERED server-to-server OAuth application.
# This Client ID is separate from BS_CLIENT_ID above.
D2L_OAUTH2_CLIENT_ID=REPLACE_WITH_EXISTING_SERVER_TO_SERVER_CLIENT_ID
D2L_OAUTH2_KEY_ID=REPLACE_WITH_KID_FROM_YOUR_PUBLIC_JWKS
# Use the matching RSA private key from your working Postman setup.
# Keep this value on ONE line, using literal \n between PEM lines.
D2L_OAUTH2_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY_BODY\n-----END PRIVATE KEY-----"
D2L_OAUTH2_TOKEN_ENDPOINT=https://auth.brightspace.com/core/connect/token
# Separate scopes with spaces.
D2L_OAUTH2_SCOPES="REPLACE_WITH_REGISTERED_SCOPES"

D2L_LP_VERSION=REPLACE_WITH_EXISTING_LP_VERSION
D2L_LE_VERSION=REPLACE_WITH_EXISTING_LE_VERSION

# Keep your existing public JWKS URL in the Brightspace OAuth registration.
# That URL is not an environment variable needed by this app.
# No OAuth client secret or refresh token is needed.
